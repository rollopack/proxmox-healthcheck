# ---------------------------------------------------------------------------
# Checks: storage
# ---------------------------------------------------------------------------

# Parse values out of a smartctl attribute table (kept in SMART_TEXT).
# Attribute names may be truncated by smartctl, so a prefix match is used.
SMART_TEXT=""
smart_field() {  # <column> <name>...  -> column of the first matching attribute
    local idx="$1"; shift
    local name v
    for name in "$@"; do
        v=$(printf '%s\n' "$SMART_TEXT" | awk -v n="$name" -v i="$idx" \
            '($2 == n || index($2, n) == 1 || index(n, $2) == 1) { print $i; exit }')
        if [[ -n $v ]]; then printf '%s\n' "$v"; return 0; fi
    done
    return 0
}
smart_raw() {  # <name>...  -> first numeric field of RAW_VALUE
    local name v
    for name in "$@"; do
        v=$(printf '%s\n' "$SMART_TEXT" | awk -v n="$name" \
            '($2 == n || index($2, n) == 1 || index(n, $2) == 1) { for (i = 10; i <= NF; i++) if ($i ~ /^-?[0-9]+$/) { print $i; exit } }')
        if [[ -n $v ]]; then printf '%s\n' "$v"; return 0; fi
    done
    return 0
}

do_storage_smart() {
    check_begin storage.smart "$(check_title storage.smart)"
    if ! have smartctl; then
        skip "smartctl not installed"
        check_end
        return 0
    fi

    # Collect unique disks across all pools.
    declare -A seen=()
    local pool dev real pct_used wear realloc poh temp spare
    local life_remain pe_max pe_avg grown corroborated
    for pool in "${PH_POOLS[@]}"; do
        while IFS= read -r dev; do
            [[ -z $dev ]] && continue
            real=$(disk_real "$dev")
            [[ -n ${seen[$real]:-} ]] && continue
            seen["$real"]=1
            subhead "device: $real"
            local out=""
            if have smartctl; then
                out=$(smartctl -a -d auto "$real" 2>/dev/null || true)
                [[ -z $out ]] && out=$(smartctl -a "$real" 2>/dev/null || true)
            fi
            if [[ -z $out ]]; then
                info "no SMART data for $real (need root or unsupported device)"
                continue
            fi

            SMART_TEXT="$out"
            # NVMe style fields (colon separated).
            pct_used=$(printf '%s\n' "$out" | awk -F: '/Percentage Used/{gsub(/[^0-9]/, "", $2); print $2; exit}')
            spare=$(printf '%s\n' "$out" | awk -F: '/Available Spare:/{gsub(/[^0-9]/, "", $2); print $2; exit}')
            poh=$(printf '%s\n' "$out" | awk -F: '/Power On Hours:/{gsub(/[^0-9]/, "", $2); print $2; exit}')
            temp=$(printf '%s\n' "$out" | awk -F: '/^Temperature:/{gsub(/[^0-9]/, "", $2); print $2; exit}')
            [[ -z $temp ]] && temp=$(printf '%s\n' "$out" | awk -F: '/Current Temperature:/{gsub(/[^0-9]/, "", $2); print $2; exit}')
            # ATA attribute table fallbacks.
            [[ -z $spare ]] && spare=$(smart_field 4 Available_Reservd_Space)
            [[ -z $poh ]] && poh=$(smart_raw Power_On_Hours)
            [[ -z $temp ]] && temp=$(smart_raw Temperature_Celsius)
            life_remain=$(smart_field 4 Percent_Lifetime_Remain Percentage_Lifetime_Remain SSD_Life_Left)
            wear=$(smart_field 4 Wear_Leveling_Count Media_Wearout_Indicator)
            pe_max=$(smart_raw Maximum_PE_Cycles_TLC Maximum_PE_Cycles Max_PE_Cycles)
            pe_avg=$(smart_raw Average_PE_Cycles_TLC Average_PE_Cycles)
            grown=$(smart_raw Grown_Bad_Blocks)
            realloc=$(smart_raw Reallocated_Sector_Ct)

            metric "Power-on hours" "${poh:-N/A}"
            metric "Temperature (C)" "${temp:-N/A}"
            [[ -n $spare ]] && metric "Available spare (%)" "$spare"
            [[ -n $pct_used ]] && metric "NVMe percentage used (%)" "$pct_used"
            [[ -n $life_remain ]] && metric "Remaining life (%)" "$life_remain"
            [[ -n $wear ]] && metric "Vendor wear indicator" "$wear"
            [[ -n $pe_avg ]] && metric "Average P/E cycles" "$pe_avg"
            [[ -n $pe_max ]] && metric "Max P/E cycles" "$pe_max"
            [[ -n $grown ]] && metric "Grown bad blocks" "$grown"
            [[ -n $realloc ]] && metric "Reallocated sectors" "$realloc"

            # NVMe percentage used: authoritative.
            if is_number "${pct_used:-}" && ge "$pct_used" "$PH_THRESH_SSD_WEAR_WARN"; then
                warn "$real: NVMe wear ${pct_used}% >= ${PH_THRESH_SSD_WEAR_WARN}%"
            fi

            # Explicit remaining-life attribute: authoritative.
            if is_number "${life_remain:-}"; then
                local life_used
                life_used=$(awk -v v="$life_remain" 'BEGIN { printf "%d", 100 - v }')
                if ge "$life_used" "$PH_THRESH_SSD_WEAR_WARN"; then
                    warn "$real: SSD life used ${life_used}% >= ${PH_THRESH_SSD_WEAR_WARN}% (${life_remain}% remaining)"
                fi
            fi

            # P/E cycle counters: used when a rated endurance is configured.
            if is_number "${pe_max:-}"; then
                if is_number "$PH_THRESH_SSD_PE_CYCLES" && gt "$PH_THRESH_SSD_PE_CYCLES" 0; then
                    local pe_used pe_str
                    pe_used=$(pct_of "$pe_max" "$PH_THRESH_SSD_PE_CYCLES")
                    pe_str="max ${pe_max}"
                    [[ -n $pe_avg ]] && pe_str="${pe_str}, avg ${pe_avg}"
                    if is_number "$pe_used" && ge "$pe_used" "$PH_THRESH_SSD_WEAR_WARN"; then
                        warn "$real: P/E cycles (${pe_str}) at ${pe_used}% of rated ${PH_THRESH_SSD_PE_CYCLES}"
                    fi
                else
                    info "$real: P/E counters present (max ${pe_max}); set PH_THRESH_SSD_PE_CYCLES to rate the wear"
                fi
            fi

            # Vendor wear indicator: only when no authoritative source exists and
            # only if corroborated by another wear or failure signal.
            if [[ -z $life_remain ]] && ! is_number "${pe_max:-}" && ! is_number "${pct_used:-}"; then
                if is_number "${wear:-}" && lt "$wear" "$((100 - PH_THRESH_SSD_WEAR_WARN))"; then
                    corroborated=0
                    if is_number "${realloc:-}" && gt "$realloc" 0; then corroborated=1; fi
                    if is_number "${grown:-}" && gt "$grown" 0; then corroborated=1; fi
                    if is_number "${spare:-}" && lt "$spare" 100; then corroborated=1; fi
                    if (( corroborated == 1 )); then
                        warn "$real: SSD remaining life ${wear}% below threshold (vendor indicator)"
                    else
                        info "$real: vendor wear indicator reports ${wear}% but no corroborating defects; not flagged as worn"
                    fi
                fi
            fi

            if is_number "${realloc:-}" && gt "$realloc" "$PH_THRESH_REALLOC_WARN"; then
                warn "$real: ${realloc} reallocated sector(s)"
            fi
            if is_number "${temp:-}" && ge "$temp" "$PH_THRESH_TEMP_CRIT"; then
                crit "$real: temperature ${temp}C >= ${PH_THRESH_TEMP_CRIT}C"
            elif is_number "${temp:-}" && ge "$temp" "$PH_THRESH_TEMP_WARN"; then
                warn "$real: temperature ${temp}C >= ${PH_THRESH_TEMP_WARN}C"
            fi
        done < <(pool_leaf_devices "$pool")
    done

    if (( ${#seen[@]} == 0 )); then
        skip "no disks discovered in the selected pools"
    else
        ok "SMART data collected for ${#seen[@]} device(s)"
    fi
    check_end
}

# ---------------------------------------------------------------------------
# Checks: VM / CT
# ---------------------------------------------------------------------------
do_vm_overcommit() {
    check_begin vm.overcommit "$(check_title vm.overcommit)"
    if (( ${#PH_GUEST_ID[@]} == 0 )); then
        skip "no VM/CT detected"
        check_end
        return 0
    fi

    local total_cores total_ram vcpu_sum ram_sum i type id name st cfg cores sockets ram vcpu
    total_cores=$(nproc 2>/dev/null || echo 0)
    total_ram=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')
    total_ram=${total_ram:-0}
    metric "Physical cores" "$total_cores"
    metric "Physical RAM (MiB)" "$total_ram"

    _emit ""
    _emit "$(printf '%-6s %-8s %-22s %-6s %-10s %-10s' 'VMID' 'TYPE' 'NAME' 'vCPU' 'RAM(MiB)' 'STATUS')"
    vcpu_sum=0; ram_sum=0
    for i in "${!PH_GUEST_ID[@]}"; do
        type="${PH_GUEST_TYPE[$i]}"; id="${PH_GUEST_ID[$i]}"
        name="${PH_GUEST_NAME[$i]}"; st="${PH_GUEST_STATUS[$i]}"
        cfg=$(guest_config "$type" "$id")
        if [[ $type == qemu ]]; then
            cores=$(conf_field "$cfg" cores); cores=${cores:-1}
            sockets=$(conf_field "$cfg" sockets); sockets=${sockets:-1}
            vcpu=$((cores * sockets))
        else
            cores=$(conf_field "$cfg" cores); cores=${cores:-1}
            vcpu=$cores
        fi
        ram=$(conf_field "$cfg" memory); ram=${ram:-0}
        vcpu_sum=$((vcpu_sum + vcpu))
        ram_sum=$((ram_sum + ram))
        _emit "$(printf '%-6s %-8s %-22s %-6s %-10s %-10s' "$id" "$type" "${name:0:22}" "$vcpu" "$ram" "$st")"
    done

    local vcpu_ratio ram_ratio
    vcpu_ratio=$(ratio_of "$vcpu_sum" "$total_cores")
    ram_ratio=$(ratio_of "$ram_sum" "$total_ram")
    _emit ""
    metric "vCPU allocated" "$vcpu_sum (ratio ${vcpu_ratio}x)"
    metric "RAM allocated (MiB)" "$ram_sum (ratio ${ram_ratio}x)"

    if is_number "$vcpu_ratio" && gt "$vcpu_ratio" "$PH_THRESH_VCPU_OVERCOMMIT_WARN"; then
        warn "vCPU overcommit ${vcpu_ratio}x > ${PH_THRESH_VCPU_OVERCOMMIT_WARN}x"
    fi
    if is_number "$ram_ratio" && gt "$ram_ratio" "$PH_THRESH_RAM_OVERCOMMIT_WARN"; then
        warn "RAM overcommit ${ram_ratio}x > ${PH_THRESH_RAM_OVERCOMMIT_WARN}x (swap/OOM risk)"
    fi
    if is_number "$vcpu_ratio" && is_number "$ram_ratio" \
       && ! gt "$vcpu_ratio" "$PH_THRESH_VCPU_OVERCOMMIT_WARN" \
       && ! gt "$ram_ratio" "$PH_THRESH_RAM_OVERCOMMIT_WARN"; then
        ok "resource allocation within thresholds"
    fi
    check_end
}

do_vm_usage() {
    check_begin vm.usage "$(check_title vm.usage)"
    if ! have pvesh; then
        skip "pvesh not available"
        check_end
        return 0
    fi
    if (( ${#PH_GUEST_ID[@]} == 0 )); then
        skip "no VM/CT detected"
        check_end
        return 0
    fi

    _emit ""
    _emit "$(printf '%-6s %-8s %-22s %-8s %-10s %-12s %-12s' 'VMID' 'TYPE' 'NAME' 'STATUS' '%CPU' 'MEM(MiB)' 'MEM%')"
    local i type id name st data cpu mem maxmem mem_mb max_mb cpu_pct mem_pct
    for i in "${!PH_GUEST_ID[@]}"; do
        type="${PH_GUEST_TYPE[$i]}"; id="${PH_GUEST_ID[$i]}"
        name="${PH_GUEST_NAME[$i]}"; st="${PH_GUEST_STATUS[$i]}"
        [[ $st != running ]] && continue
        data=$(pvesh get "/nodes/${PH_NODE}/${type}/${id}/status/current" --output-format json 2>/dev/null || true)
        [[ -z $data ]] && continue
        name=$(json_get "$data" name); name=${name:-${PH_GUEST_NAME[$i]}}
        cpu=$(json_get "$data" cpu)
        mem=$(json_get "$data" mem)
        maxmem=$(json_get "$data" maxmem)
        cpu_pct="N/A"; mem_pct="N/A"; mem_mb="N/A"; max_mb="N/A"
        if is_number "${cpu:-}"; then cpu_pct=$(awk -v v="$cpu" 'BEGIN{printf "%.1f", v*100}'); fi
        if is_number "${mem:-}" && is_number "${maxmem:-}" && gt "$maxmem" 0; then
            mem_mb=$((mem / 1024 / 1024)); max_mb=$((maxmem / 1024 / 1024))
            mem_pct=$(pct_of "$mem" "$maxmem")
        fi
        _emit "$(printf '%-6s %-8s %-22s %-8s %-10s %-12s %-12s' \
            "$id" "$type" "${name:0:22}" "$st" "${cpu_pct}%" "${mem_mb}/${max_mb}" "${mem_pct}%")"
    done
    _emit ""
    info "note: %CPU is a fraction of one host core (50 = half core, 200 = 2 cores)"
    ok "real usage sampled for running guests"
    check_end
}

# ---------------------------------------------------------------------------
# Checks: network
# ---------------------------------------------------------------------------
discover_bridges() {
    local br
    declare -A bset=()
    if have ip; then
        while IFS= read -r br; do
            [[ -n $br ]] && bset["$br"]=1
        done < <(ip -o link show type bridge 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1)
    fi
    if [[ -r $PH_NET_INTERFACES ]]; then
        while IFS= read -r br; do
            [[ -n $br ]] && bset["$br"]=1
        done < <(awk '$1 == "iface" && $2 ~ /^vmbr?[0-9]/ {print $2}' "$PH_NET_INTERFACES" 2>/dev/null)
    fi
    printf '%s\n' "${!bset[@]}" | sort
}

do_net_bridges() {
    check_begin net.bridges "$(check_title net.bridges)"
    if ! have ip && [[ ! -r $PH_NET_INTERFACES ]]; then
        skip "neither 'ip' nor ${PH_NET_INTERFACES} available"
        check_end
        return 0
    fi

    local bridges=()
    while IFS= read -r br; do
        [[ -n $br ]] && bridges+=("$br")
    done < <(discover_bridges)

    if (( ${#bridges[@]} == 0 )); then
        skip "no network bridge detected"
        check_end
        return 0
    fi

    local br state addr members
    for br in "${bridges[@]}"; do
        subhead "bridge: $br"
        state="unknown"; addr=""; members=""
        if have ip; then
            state=$(ip -br link show "$br" 2>/dev/null | awk '{print $2}')
            state=${state:-unknown}
            addr=$(ip -br addr show "$br" 2>/dev/null | awk 'NR==1{$1=$2=""; sub(/^ +/, ""); print}')
            members=$(ip -o link show master "$br" 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | paste -sd, -)
        fi
        metric "State" "$state"
        metric "Addresses" "${addr:-none}"
        metric "Member interfaces" "${members:-none}"
        if [[ $state == UP ]]; then
            ok "bridge $br is UP"
        elif [[ $state == UNKNOWN || -z $state ]]; then
            warn "bridge $br state unknown"
        else
            warn "bridge $br is $state"
        fi
    done
    check_end
}

# ---------------------------------------------------------------------------
# Checks: hardware
# ---------------------------------------------------------------------------
do_hardware_sensors() {
    check_begin hardware.sensors "$(check_title hardware.sensors)"
    if have sensors; then
        subhead "lm-sensors"
        sensors 2>/dev/null | raw
    else
        info "lm-sensors (sensors) not installed"
    fi
    if have ipmitool; then
        subhead "IPMI"
        ipmitool sensor 2>/dev/null | grep -iE "temp|fan|cpu|mb" | raw
    else
        info "ipmitool not installed"
    fi
    ok "sensor data collected"
    check_end
}

# ---------------------------------------------------------------------------
# Checks: backup / replication (only when present)
# ---------------------------------------------------------------------------
do_backup_status() {
    check_begin backup.status "$(check_title backup.status)"
    if ! have pvesh; then
        skip "pvesh not available"
        check_end
        return 0
    fi

    local jobs=""
    jobs=$(pvesh get /cluster/backup --output-format json 2>/dev/null || true)
    if [[ -z $jobs || $jobs == "[]" || $jobs == "{}" ]]; then
        if [[ ! -f /etc/pve/vzdump.cron ]]; then
            skip "no backup job configured"
            check_end
            return 0
        fi
    fi

    local tasks
    tasks=$(pvesh get "/nodes/${PH_NODE}/tasks" --typefilter vzdump --limit 50 --output-format json 2>/dev/null || true)
    if [[ -z $tasks || $tasks == "[]" ]]; then
        info "no recent vzdump task found for node ${PH_NODE}"
        check_end
        return 0
    fi

    _emit ""
    _emit "$(printf '%-6s %-20s %-10s %s' 'VMID' 'DATE' 'STATUS' 'UPID')"
    local obj vmid status starttime date_str failures
    failures=0
    while IFS= read -r obj; do
        [[ -z $obj ]] && continue
        vmid=$(json_get "$obj" id)
        status=$(json_get "$obj" status)
        starttime=$(json_get "$obj" starttime)
        date_str="?"
        if is_number "${starttime:-}"; then
            date_str=$(date -d "@${starttime}" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
        fi
        _emit "$(printf '%-6s %-20s %-10s %s' "${vmid:-?}" "$date_str" "${status:-?}" "-")"
        if [[ -n $status && $status != OK ]]; then
            failures=$((failures + 1))
        fi
    done < <(printf '%s' "$tasks" | json_lines)

    _emit ""
    if (( failures > 0 )); then
        warn "${failures} recent vzdump task(s) did not finish OK"
    else
        ok "recent vzdump tasks completed successfully"
    fi
    check_end
}

do_replication_status() {
    check_begin replication.status "$(check_title replication.status)"
    if ! have pvesr; then
        skip "pvesr not available (single node or no replication tooling)"
        check_end
        return 0
    fi
    local out
    out=$(pvesr status 2>/dev/null || true)
    if [[ -z $out ]]; then
        skip "no replication job configured"
        check_end
        return 0
    fi
    printf '%s\n' "$out" | raw
    if printf '%s\n' "$out" | grep -qiE 'fail|error'; then
        warn "at least one replication job reports a failure"
    else
        ok "no replication failure detected"
    fi
    check_end
}

# ---------------------------------------------------------------------------
# Check runner
# ---------------------------------------------------------------------------
run_check() {
    case $1 in
        host.resources)      do_host_resources ;;
        host.systemd)        do_host_systemd ;;
        zfs.pool_health)     do_zfs_pool_health ;;
        zfs.datasets)        do_zfs_datasets ;;
        zfs.arc)             do_zfs_arc ;;
        zfs.trim)            do_zfs_trim ;;
        zfs.dedup)           do_zfs_dedup ;;
        zfs.iostat)          do_zfs_iostat ;;
        storage.smart)       do_storage_smart ;;
        vm.overcommit)       do_vm_overcommit ;;
        vm.usage)            do_vm_usage ;;
        net.bridges)         do_net_bridges ;;
        hardware.sensors)    do_hardware_sensors ;;
        backup.status)       do_backup_status ;;
        replication.status)  do_replication_status ;;
        *)                   err "unknown check: $1" ;;
    esac
}

select_checks() {
    CHECKS=()
    if [[ -z $PH_SELECT ]]; then
        CHECKS=("${CHECKS_ALL[@]}")
        return 0
    fi
    local item id found
    for item in ${PH_SELECT//,/ }; do
        found=0
        for id in "${CHECKS_ALL[@]}"; do
            if [[ $id == "$item" ]]; then
                CHECKS+=("$item"); found=1; break
            fi
        done
        if (( found == 0 )); then
            err "unknown check: $item"
            err "use --list-checks to see the available ids"
            return 2
        fi
    done
    return 0
}

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
print_header() {
    _emit "$(printf '%s v%s' "$PH_PROG" "$PH_VERSION")" "$C_BOLD"
    metric "Date" "$(date '+%Y-%m-%d %H:%M:%S %z')"
    metric "Node" "$PH_NODE"
    metric "Proxmox VE" "$(pve_version)"
    metric "Kernel" "$(uname -sr 2>/dev/null || echo unknown)"
    if (( ${#PH_POOLS[@]} > 0 )); then
        metric "ZFS pools" "${PH_POOLS[*]}"
    else
        metric "ZFS pools" "none detected"
    fi
    if (( ${#PH_GUEST_ID[@]} > 0 )); then
        metric "Guests" "${#PH_GUEST_ID[@]} (VMs + CTs)"
    else
        metric "Guests" "none detected"
    fi
}

print_summary() {
    local line="=================================================================="
    _emit_force ""
    _emit_force "$line" "$C_BOLD"
    _emit_force "Summary"
    _emit_force "$line" "$C_BOLD"

    local id status sev ok_n=0 warn_n=0 crit_n=0 skip_n=0
    for id in "${CHECKS[@]}"; do
        sev="${CK_SEV[$id]:-0}"
        if [[ "${CK_STATUS[$id]:-ok}" == skip ]]; then
            status="SKIPPED"; skip_n=$((skip_n + 1))
        elif (( sev >= 2 )); then
            status="CRITICAL"; crit_n=$((crit_n + 1))
        elif (( sev == 1 )); then
            status="WARNING"; warn_n=$((warn_n + 1))
        else
            status="OK"; ok_n=$((ok_n + 1))
        fi
        _emit_force "$(printf '  %-22s %s' "$id" "$status")" "$(status_color "$status")"
    done
    _emit_force ""
    _emit_force "$(printf '  checks: %d OK, %d WARNING, %d CRITICAL, %d SKIPPED' \
        "$ok_n" "$warn_n" "$crit_n" "$skip_n")"

    # Findings that need attention.
    if (( warn_n + crit_n > 0 )); then
        _emit_force ""
        _emit_force "Findings:" "$C_BOLD"
        local finding
        for id in "${CHECKS[@]}"; do
            while IFS= read -r finding; do
                [[ -z $finding ]] && continue
                case ${finding%%|*} in
                    warn) _emit_force "  [WARN] ${id}: ${finding#*|}" "$C_YELLOW" ;;
                    crit) _emit_force "  [CRIT] ${id}: ${finding#*|}" "$C_RED" ;;
                esac
            done <<<"${CK_FINDINGS[$id]:-}"
        done
    fi

    _emit_force ""
    if (( PH_STATUS == 0 )); then
        _emit_force "Overall status: OK" "$C_GREEN"
    elif (( PH_STATUS == 1 )); then
        _emit_force "Overall status: WARNING" "$C_YELLOW"
    else
        _emit_force "Overall status: CRITICAL" "$C_RED"
    fi
    if [[ -n $PH_OUTPUT ]]; then
        _emit_force "Report written to: $PH_OUTPUT"
    fi
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
load_config() {
    local cfg="$PH_CONFIG"
    if [[ -n $cfg && -r $cfg ]]; then
        # shellcheck source=/dev/null
        source "$cfg"
    fi
}

apply_env_overrides() {
    local line k v
    while IFS= read -r line; do
        k="${line%%=*}"
        v="${line#*=}"
        case $k in
            PH_*) printf -v "$k" '%s' "$v" ;;
        esac
    done < <(env 2>/dev/null)
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
ARG_SELECT=""; ARG_POOL=""; ARG_NODE=""; ARG_OUTPUT=""; ARG_NO_COLOR=""
ARG_QUIET=""; ARG_CONFIG=""; MODE="run"

usage() {
    cat <<EOF
$PH_PROG v$PH_VERSION - Proxmox VE diagnostics and integrity checks

Usage: $PH_PROG [options]

Options:
  -c, --check ID[,ID...]   run only the given checks (see --list-checks)
      --pool NAME[,NAME]   restrict ZFS checks to these pools
      --node NAME          Proxmox node name (default: auto-detect)
  -o, --output FILE        also write the report to FILE
      --no-color           disable colored output (also honours NO_COLOR)
  -q, --quiet              print only the final summary
      --config FILE        configuration file (default: $PH_CONFIG)
      --list-checks        list the available check ids and exit
  -v, --version            print version and exit
  -h, --help               show this help and exit

Exit codes: 0 = OK, 1 = WARNING or CRITICAL, 2 = usage/setup error

Examples:
  $PH_PROG
  $PH_PROG -c zfs.pool_health,storage.smart --pool rpool
  $PH_PROG -o /var/tmp/pve-report.txt --no-color
EOF
}

parse_args() {
    while (( $# )); do
        case $1 in
            -c|--check)   ARG_SELECT="${ARG_SELECT:+$ARG_SELECT,}${2:?missing value for $1}"; shift 2 ;;
            --check=*)    ARG_SELECT="${ARG_SELECT:+$ARG_SELECT,}${1#*=}"; shift ;;
            --pool)       ARG_POOL="${2:?missing value for $1}"; shift 2 ;;
            --pool=*)     ARG_POOL="${1#*=}"; shift ;;
            --node)       ARG_NODE="${2:?missing value for $1}"; shift 2 ;;
            --node=*)     ARG_NODE="${1#*=}"; shift ;;
            -o|--output)  ARG_OUTPUT="${2:?missing value for $1}"; shift 2 ;;
            --output=*)   ARG_OUTPUT="${1#*=}"; shift ;;
            --config)     ARG_CONFIG="${2:?missing value for $1}"; shift 2 ;;
            --config=*)   ARG_CONFIG="${1#*=}"; shift ;;
            --no-color)   ARG_NO_COLOR=1; shift ;;
            -q|--quiet)   ARG_QUIET=1; shift ;;
            --list-checks) MODE="list"; shift ;;
            -v|--version)  MODE="version"; shift ;;
            -h|--help)     MODE="help"; shift ;;
            --)           shift; break ;;
            *)            err "unknown option: $1"; usage >&2; exit 2 ;;
        esac
    done
}

apply_cli() {
    [[ -n $ARG_SELECT ]]   && PH_SELECT="$ARG_SELECT"
    [[ -n $ARG_POOL ]]     && PH_POOL_OPT="$ARG_POOL"
    [[ -n $ARG_NODE ]]     && PH_NODE="$ARG_NODE"
    [[ -n $ARG_OUTPUT ]]   && PH_OUTPUT="$ARG_OUTPUT"
    [[ -n $ARG_CONFIG ]]   && PH_CONFIG="$ARG_CONFIG"
    [[ -n $ARG_NO_COLOR ]] && PH_NO_COLOR="$ARG_NO_COLOR"
    [[ -n $ARG_QUIET ]]    && PH_QUIET="$ARG_QUIET"
}

open_output() {
    if [[ -n $PH_OUTPUT ]]; then
        if ! : >"$PH_OUTPUT" 2>/dev/null; then
            err "cannot write to output file: $PH_OUTPUT"
            exit 2
        fi
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    parse_args "$@"

    case $MODE in
        help)    usage; exit 0 ;;
        version) echo "$PH_PROG v$PH_VERSION"; exit 0 ;;
        list)
            local id
            for id in "${CHECKS_ALL[@]}"; do
                printf '%-22s %s\n' "$id" "$(check_title "$id")"
            done
            exit 0 ;;
    esac

    # Defaults already set; config file first, then environment, then CLI.
    load_config
    apply_env_overrides
    apply_cli

    setup_colors
    open_output

    if ! select_checks; then
        exit 2
    fi
    TOTAL_SELECTED=${#CHECKS[@]}

    detect_node
    discover_pools
    discover_guests

    print_header
    local id
    for id in "${CHECKS[@]}"; do
        run_check "$id"
    done
    print_summary

    if (( PH_STATUS > 0 )); then
        exit 1
    fi
    exit 0
}

main "$@"
