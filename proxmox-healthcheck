#!/usr/bin/env bash
#
# proxmox-healthcheck - diagnostics and integrity checks for a Proxmox VE
# node/cluster and its ZFS storage, VMs and LXC containers.
#
# Design goals:
#   - no hardcoded pools/disks/guests: everything is auto-discovered
#   - the check layer only records results; the report layer prints them
#   - tools that are missing make a check skip, never fail
#
# Exit codes: 0 = OK, 1 = at least one WARNING or CRITICAL, 2 = usage/setup error
#
# License: MIT

# NOTE: `set -e` is intentionally NOT used. Several checks rely on commands
# that are expected to fail (grep with no match, zpool/zfs probes, optional
# tools). We still want `-u` and `pipefail` for robustness.
set -uo pipefail

# Force a deterministic locale: zpool/zfs/date output must be parsed reliably
# regardless of the system locale.
export LC_ALL=C

PH_PROG="proxmox-healthcheck"
PH_VERSION="0.1.1"

# ---------------------------------------------------------------------------
# Defaults (overridden by: config file -> environment -> command line)
# ---------------------------------------------------------------------------
PH_CONFIG="${PH_CONFIG:-/etc/proxmox-healthcheck.conf}"

PH_SELECT=""            # comma separated list of check ids
PH_POOL_OPT=""          # comma separated list of pools (empty = auto-discovery)
PH_NODE=""              # Proxmox node name (empty = auto-detect)
PH_OUTPUT=""            # optional report file
PH_NO_COLOR=0
PH_QUIET=0
PH_IO_SAMPLES="${PH_IO_SAMPLES:-5}"
PH_ARCSTATS="${PH_ARCSTATS:-/proc/spl/kstat/zfs/arcstats}"
PH_NET_INTERFACES="${PH_NET_INTERFACES:-/etc/network/interfaces}"

# Thresholds
PH_THRESH_POOL_CAP_WARN="${PH_THRESH_POOL_CAP_WARN:-80}"
PH_THRESH_POOL_CAP_CRIT="${PH_THRESH_POOL_CAP_CRIT:-90}"
PH_THRESH_POOL_FRAG_WARN="${PH_THRESH_POOL_FRAG_WARN:-50}"
PH_THRESH_SCRUB_WARN_DAYS="${PH_THRESH_SCRUB_WARN_DAYS:-30}"
PH_THRESH_SCRUB_CRIT_DAYS="${PH_THRESH_SCRUB_CRIT_DAYS:-60}"
PH_THRESH_VCPU_OVERCOMMIT_WARN="${PH_THRESH_VCPU_OVERCOMMIT_WARN:-4.0}"
PH_THRESH_RAM_OVERCOMMIT_WARN="${PH_THRESH_RAM_OVERCOMMIT_WARN:-1.2}"
PH_THRESH_ARC_HIT_WARN="${PH_THRESH_ARC_HIT_WARN:-0}"      # 0 = informational only
PH_THRESH_SWAP_WARN_PCT="${PH_THRESH_SWAP_WARN_PCT:-10}"    # warn if swap used >= % of total
PH_THRESH_SSD_WEAR_WARN="${PH_THRESH_SSD_WEAR_WARN:-80}"   # % of life consumed
PH_THRESH_SSD_PE_CYCLES="${PH_THRESH_SSD_PE_CYCLES:-0}"    # rated P/E cycles (0 = unknown)
PH_THRESH_REALLOC_WARN="${PH_THRESH_REALLOC_WARN:-0}"      # reallocated sectors
PH_THRESH_TEMP_WARN="${PH_THRESH_TEMP_WARN:-70}"
PH_THRESH_TEMP_CRIT="${PH_THRESH_TEMP_CRIT:-85}"
PH_THRESH_BACKUP_AGE_DAYS="${PH_THRESH_BACKUP_AGE_DAYS:-7}"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
setup_colors() {
    if [[ $PH_NO_COLOR -eq 1 || -n "${NO_COLOR:-}" || ! -t 1 ]]; then
        C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""
    else
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
    fi
}
C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
err() { printf '%s: %s\n' "$PH_PROG" "$*" >&2; }

# Write a line to the report file (if any) and to stdout (unless quiet).
_emit() {
    local text="$1" color="${2:-}"
    [[ -n $PH_OUTPUT ]] && printf '%s\n' "$text" >>"$PH_OUTPUT"
    [[ $PH_QUIET -eq 1 ]] && return 0
    if [[ -n $color ]]; then
        printf '%b%s%b\n' "$color" "$text" "$C_RESET"
    else
        printf '%s\n' "$text"
    fi
}

# Like _emit but never silenced by --quiet (used for the final summary).
_emit_force() {
    local text="$1" color="${2:-}"
    [[ -n $PH_OUTPUT ]] && printf '%s\n' "$text" >>"$PH_OUTPUT"
    if [[ -n $color ]]; then
        printf '%b%s%b\n' "$color" "$text" "$C_RESET"
    else
        printf '%s\n' "$text"
    fi
}

# Emit every line read from stdin, verbatim.
raw() {
    local line
    while IFS= read -r line; do _emit "$line"; done
}

# ---------------------------------------------------------------------------
# Small numeric helpers (awk based: no dependency on bc/numfmt)
# ---------------------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

human_bytes() {
    awk -v n="${1:-0}" 'BEGIN {
        if (n !~ /^[0-9.]+$/) { print n; exit }
        split("B KiB MiB GiB TiB PiB", u, " "); i = 1
        while (n >= 1024 && i < 7) { n /= 1024; i++ }
        printf "%.2f %s\n", n, u[i]
    }'
}

pct_of() { awk -v a="${1:-0}" -v b="${2:-0}" 'BEGIN { if (b > 0) printf "%.1f", a*100/b; else printf "N/A" }'; }
ratio_of() { awk -v a="${1:-0}" -v b="${2:-0}" 'BEGIN { if (b > 0) printf "%.2f", a/b; else printf "N/A" }'; }
gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }
lt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }'; }
is_number() { awk -v n="$1" 'BEGIN { exit !(n ~ /^-?[0-9]+(\.[0-9]+)?$/) }'; }

# Extract a value from a compact JSON string without jq.
# Usage: json_get '<json>' 'key'
json_get() {
    awk -v k="$2" '
        {
            line = $0
            pat = "\"" k "\":"
            idx = index(line, pat)
            if (idx == 0) next
            rest = substr(line, idx + length(pat))
            if (substr(rest, 1, 1) == "\"") {
                rest = substr(rest, 2)
                q = index(rest, "\"")
                print substr(rest, 1, q - 1)
            } else {
                n = 0
                for (i = 1; i <= length(rest); i++) {
                    c = substr(rest, i, 1)
                    if (c == "," || c == "}" || c == "]") break
                    n = i
                }
                print substr(rest, 1, n)
            }
            exit
        }
    ' <<<"$1"
}

# Split a compact JSON array of objects into one object per line.
json_lines() { tr -d '\n' | sed 's/},{/}\n{/g'; }

# ---------------------------------------------------------------------------
# Check bookkeeping
# ---------------------------------------------------------------------------
CHECKS_ALL=(
    host.resources
    host.systemd
    zfs.pool_health
    zfs.datasets
    zfs.arc
    zfs.trim
    zfs.dedup
    zfs.iostat
    storage.smart
    vm.overcommit
    vm.usage
    net.bridges
    hardware.sensors
    backup.status
    replication.status
)
CHECKS=()
TOTAL_SELECTED=0
CURRENT_INDEX=0
CURRENT_ID=""
CURRENT_TITLE=""

PH_STATUS=0                 # 0 ok, 1 warn, 2 crit
declare -A CK_SEV=()        # per-check numeric worst severity
declare -A CK_STATUS=()     # per-check status label
declare -A CK_FINDINGS=()   # per-check findings (severity|message lines)

check_title() {
    case $1 in
        host.resources)      echo "Host resources" ;;
        host.systemd)        echo "Failed systemd units" ;;
        zfs.pool_health)     echo "ZFS pool health" ;;
        zfs.datasets)        echo "ZFS datasets and zvols" ;;
        zfs.arc)             echo "ZFS ARC statistics" ;;
        zfs.trim)            echo "ZFS TRIM status" ;;
        zfs.dedup)           echo "ZFS dedup ratio" ;;
        zfs.iostat)          echo "ZFS I/O statistics" ;;
        storage.smart)       echo "Disk SMART / wear level" ;;
        vm.overcommit)       echo "VM/CT resource overcommit" ;;
        vm.usage)            echo "VM/CT real usage" ;;
        net.bridges)         echo "Network bridges" ;;
        hardware.sensors)    echo "CPU temperature and fans" ;;
        backup.status)       echo "Backup status" ;;
        replication.status)  echo "Replication status" ;;
        *)                   echo "$1" ;;
    esac
}

status_color() {
    case $1 in
        OK)       printf '%s' "$C_GREEN" ;;
        WARNING)  printf '%s' "$C_YELLOW" ;;
        CRITICAL) printf '%s' "$C_RED" ;;
        *)        printf '%s' "$C_DIM" ;;
    esac
}

check_begin() {
    CURRENT_ID="$1"
    CURRENT_TITLE="$2"
    CURRENT_INDEX=$((CURRENT_INDEX + 1))
    CK_SEV["$CURRENT_ID"]=0
    CK_STATUS["$CURRENT_ID"]="ok"
    local line="=================================================================="
    _emit ""
    _emit "$line" "$C_BOLD"
    _emit "$(printf '[%d/%d] %s' "$CURRENT_INDEX" "$TOTAL_SELECTED" "$CURRENT_TITLE")" "$C_BOLD"
    _emit "$line" "$C_BOLD"
}

# note <ok|info|warn|crit|skip> <message>
note() {
    local sev="$1"; shift
    local msg="$*"
    local color="" tag="" num=0
    case $sev in
        ok)   tag="[ OK ]";  color="$C_GREEN" ;;
        info) tag="[info]";  color="$C_DIM" ;;
        warn) tag="[WARN]";  color="$C_YELLOW"; num=1 ;;
        crit) tag="[CRIT]";  color="$C_RED";    num=2 ;;
        skip) tag="[skip]";  color="$C_DIM" ;;
        *)    tag="[????]";  color="$C_DIM" ;;
    esac
    if [[ $sev == skip ]]; then
        CK_STATUS["$CURRENT_ID"]="skip"
    fi
    if (( num > ${CK_SEV[$CURRENT_ID]:-0} )); then
        CK_SEV["$CURRENT_ID"]=$num
    fi
    if (( num > PH_STATUS )); then
        PH_STATUS=$num
    fi
    CK_FINDINGS["$CURRENT_ID"]+="${sev}|${msg}"$'\n'
    _emit "$tag $msg" "$color"
}

ok()   { note ok "$@"; }
info() { note info "$@"; }
warn() { note warn "$@"; }
crit() { note crit "$@"; }
skip() { note skip "$@"; }

# metric <label> <value>
metric() {
    local label="$1" value="${2:-}"
    _emit "$(printf '  %-30s %s' "$label" "$value")"
}

# Print a sub-heading inside a check.
subhead() { _emit "" ; _emit "-- $*" "$C_CYAN"; }

check_end() {
    local id="$CURRENT_ID"
    local sev="${CK_SEV[$id]:-0}"
    local status
    if [[ "${CK_STATUS[$id]:-ok}" == skip ]]; then
        status="SKIPPED"
    elif (( sev >= 2 )); then
        status="CRITICAL"
    elif (( sev == 1 )); then
        status="WARNING"
    else
        status="OK"
    fi
    _emit "Result: $status" "$(status_color "$status")"
}

# ---------------------------------------------------------------------------
# Auto-discovery
# ---------------------------------------------------------------------------
PH_POOLS=()
PH_GUEST_TYPE=()   # qemu|lxc
PH_GUEST_ID=()
PH_GUEST_NAME=()
PH_GUEST_STATUS=()

detect_node() {
    [[ -n $PH_NODE ]] && return 0
    if have pvecm; then
        PH_NODE=$(pvecm status 2>/dev/null | awk -F': *' '/^Name:/{print $2; exit}')
    fi
    [[ -n $PH_NODE ]] && return 0
    PH_NODE=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo "unknown")
}

pve_version() {
    if have pveversion; then
        pveversion 2>/dev/null | head -n1
    elif [[ -r /etc/os-release ]]; then
        awk -F= '/^PRETTY_NAME=/{gsub(/"/, "", $2); print $2}' /etc/os-release
    else
        echo "unknown"
    fi
}

discover_pools() {
    PH_POOLS=()
    local p
    if [[ -n $PH_POOL_OPT ]]; then
        for p in ${PH_POOL_OPT//,/ }; do
            if have zpool && zpool list -H -o name "$p" >/dev/null 2>&1; then
                PH_POOLS+=("$p")
            else
                err "pool '$p' not found, skipping"
            fi
        done
    elif have zpool; then
        while IFS= read -r p; do
            [[ -n $p ]] && PH_POOLS+=("$p")
        done < <(zpool list -H -o name 2>/dev/null)
    fi
}

discover_guests() {
    PH_GUEST_TYPE=(); PH_GUEST_ID=(); PH_GUEST_NAME=(); PH_GUEST_STATUS=()
    local id name st
    if have qm; then
        while IFS='|' read -r id name st; do
            [[ -z $id ]] && continue
            PH_GUEST_TYPE+=("qemu"); PH_GUEST_ID+=("$id")
            PH_GUEST_NAME+=("$name"); PH_GUEST_STATUS+=("$st")
        done < <(qm list 2>/dev/null | awk 'NR>1 && $1 ~ /^[0-9]+$/ {print $1"|"$2"|"$3}')
    fi
    if have pct; then
        while IFS='|' read -r id st name; do
            [[ -z $id ]] && continue
            PH_GUEST_TYPE+=("lxc"); PH_GUEST_ID+=("$id")
            PH_GUEST_NAME+=("$name"); PH_GUEST_STATUS+=("$st")
        done < <(pct list 2>/dev/null | awk 'NR>1 && $1 ~ /^[0-9]+$/ {print $1"|"$2"|"$NF}')
    fi
}

# Print the raw config of a guest (qm/pct config).
guest_config() {
    local type="$1" id="$2"
    if [[ $type == qemu ]]; then
        qm config "$id" 2>/dev/null
    else
        pct config "$id" 2>/dev/null
    fi
}

# Extract a key from a guest config blob.
conf_field() {
    awk -F': *' -v k="$2" '$1 == k {print $2; exit}' <<<"$1"
}

# Leaf block devices backing a pool.
pool_leaf_devices() {
    local pool="$1"
    have zpool || return 0
    zpool status -P "$pool" 2>/dev/null | awk '
        /^[[:space:]]/ && $1 ~ /^\/dev\// { print $1 }
    '
}

# Resolve a partition to its whole disk.
disk_real() {
    local dev="$1" pk
    pk=$(lsblk -dnr -o PKNAME "$dev" 2>/dev/null | head -n1)
    if [[ -n $pk ]]; then
        printf '/dev/%s\n' "$pk"
    else
        printf '%s\n' "$dev"
    fi
}

# Is the pool built only on NVMe devices? (same logic as the Debian cron)
pool_is_nvme_only() {
    local pool="$1" dev pk trans
    [[ -n "${pool_leaf_cache[$pool]:-}" ]] || pool_leaf_cache["$pool"]=$(pool_leaf_devices "$pool")
    local leaves="${pool_leaf_cache[$pool]}"
    [[ -z $leaves ]] && return 1
    for dev in $leaves; do
        pk=$(lsblk -dnr -o PKNAME "$dev" 2>/dev/null)
        [[ -n $pk ]] && dev="/dev/${pk}"
        trans=$(lsblk -dnr -o TRAN "$dev" 2>/dev/null | head -n1)
        [[ $trans == nvme ]] || return 1
    done
    return 0
}
declare -A pool_leaf_cache=()

# ---------------------------------------------------------------------------
# Checks: host
# ---------------------------------------------------------------------------
do_host_resources() {
    check_begin host.resources "$(check_title host.resources)"

    local cores load
    cores=$(nproc 2>/dev/null || echo "?")
    metric "CPU cores (online)" "$cores"
    load=$(uptime 2>/dev/null)
    metric "Load / uptime" "${load:-N/A}"

    if have free; then
        metric "Memory" "$(free -h 2>/dev/null | awk '/^Mem:/{print $3" used / "$2" total"}')"
        local swap_mb swap_total swap_pct
        swap_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $3}')
        swap_total=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
        swap_mb=${swap_mb:-0}; swap_total=${swap_total:-0}
        swap_pct=$(pct_of "$swap_mb" "$swap_total")
        metric "Swap used (MiB)" "${swap_mb} / ${swap_total} (${swap_pct}%)"
        if is_number "$swap_pct" && is_number "$swap_total" && gt "$swap_total" 0 \
           && ge "$swap_pct" "$PH_THRESH_SWAP_WARN_PCT"; then
            warn "swap usage ${swap_pct}% >= ${PH_THRESH_SWAP_WARN_PCT}%: possible memory pressure"
        elif is_number "$swap_mb" && gt "$swap_mb" 0; then
            info "swap in use (${swap_mb} MiB), below warning threshold"
        else
            ok "no swap in use"
        fi
    else
        info "'free' not available, memory usage skipped"
    fi

    if have swapon; then
        if [[ -n "$(swapon --show 2>/dev/null)" ]]; then
            metric "Swap devices" "present"
        else
            metric "Swap devices" "none"
        fi
    fi

    if have iostat; then
        subhead "I/O statistics (iostat -x, ${PH_IO_SAMPLES} samples)"
        iostat -x 1 "$PH_IO_SAMPLES" 2>/dev/null | raw
    else
        info "'iostat' (sysstat) not installed, skipped"
    fi

    check_end
}

do_host_systemd() {
    check_begin host.systemd "$(check_title host.systemd)"
    if ! have systemctl; then
        skip "systemctl not available"
        check_end
        return 0
    fi
    local failed count
    failed=$(systemctl --failed --no-legend --plain 2>/dev/null)
    if [[ -z $failed ]]; then
        ok "no failed systemd units"
    else
        count=$(printf '%s\n' "$failed" | grep -c .)
        warn "${count} failed systemd unit(s)"
        printf '%s\n' "$failed" | raw
    fi
    check_end
}

# ---------------------------------------------------------------------------
# Checks: ZFS
# ---------------------------------------------------------------------------
do_zfs_pool_health() {
    check_begin zfs.pool_health "$(check_title zfs.pool_health)"
    if ! have zpool; then
        skip "zpool not available"
        check_end
        return 0
    fi
    if (( ${#PH_POOLS[@]} == 0 )); then
        skip "no ZFS pool detected"
        check_end
        return 0
    fi

    local pool health cap frag scan_line errors days
    for pool in "${PH_POOLS[@]}"; do
        subhead "pool: $pool"
        health=$(zpool list -H -o health "$pool" 2>/dev/null)
        metric "Health" "${health:-unknown}"
        if [[ $health == ONLINE ]]; then
            ok "pool $pool is ONLINE"
        elif [[ -n $health ]]; then
            crit "pool $pool health is ${health}"
        else
            warn "pool $pool health could not be determined"
        fi

        cap=$(zpool list -Hp -o capacity "$pool" 2>/dev/null)
        if is_number "$cap"; then
            metric "Capacity used" "${cap}%"
            if ge "$cap" "$PH_THRESH_POOL_CAP_CRIT"; then
                crit "pool $pool capacity ${cap}% >= ${PH_THRESH_POOL_CAP_CRIT}%"
            elif ge "$cap" "$PH_THRESH_POOL_CAP_WARN"; then
                warn "pool $pool capacity ${cap}% >= ${PH_THRESH_POOL_CAP_WARN}%"
            fi
        fi

        frag=$(zpool list -Hp -o fragmentation "$pool" 2>/dev/null)
        if is_number "$frag"; then
            metric "Fragmentation" "${frag}%"
            if ge "$frag" "$PH_THRESH_POOL_FRAG_WARN"; then
                warn "pool $pool fragmentation ${frag}% >= ${PH_THRESH_POOL_FRAG_WARN}%"
            fi
        else
            metric "Fragmentation" "-"
        fi

        scan_line=$(zpool status "$pool" 2>/dev/null | grep -m1 'scan:' || true)
        metric "Last scan" "${scan_line#*scan: }"
        if [[ $scan_line == *"scrub in progress"* ]]; then
            info "scrub in progress on pool $pool"
        elif [[ $scan_line == *"resilver in progress"* ]]; then
            warn "resilver in progress on pool $pool"
        elif [[ $scan_line == *"none requested"* ]]; then
            warn "pool $pool has never been scrubbed"
        elif [[ $scan_line == *" on "* ]]; then
            local last_epoch now_epoch
            last_epoch=$(date -d "${scan_line##* on }" +%s 2>/dev/null || true)
            if [[ -n $last_epoch ]]; then
                now_epoch=$(date +%s)
                days=$(( (now_epoch - last_epoch) / 86400 ))
                metric "Days since last scrub" "$days"
                if ge "$days" "$PH_THRESH_SCRUB_CRIT_DAYS"; then
                    crit "last scrub was ${days} days ago (>= ${PH_THRESH_SCRUB_CRIT_DAYS})"
                elif ge "$days" "$PH_THRESH_SCRUB_WARN_DAYS"; then
                    warn "last scrub was ${days} days ago (>= ${PH_THRESH_SCRUB_WARN_DAYS})"
                else
                    ok "recent scrub on pool $pool (${days} days ago)"
                fi
            fi
        fi

        errors=$(zpool status "$pool" 2>/dev/null | grep -m1 '^errors:' || true)
        if [[ -n $errors && $errors != *"No known data errors"* ]]; then
            crit "pool $pool reports data errors: ${errors#errors: }"
        fi

        subhead "zpool status -v $pool"
        zpool status -v "$pool" 2>&1 | raw
    done
    check_end
}

do_zfs_datasets() {
    check_begin zfs.datasets "$(check_title zfs.datasets)"
    if ! have zfs; then
        skip "zfs not available"
        check_end
        return 0
    fi
    if (( ${#PH_POOLS[@]} == 0 )); then
        skip "no ZFS pool detected"
        check_end
        return 0
    fi
    local pool
    for pool in "${PH_POOLS[@]}"; do
        subhead "datasets and volumes of $pool (largest first)"
        zfs list -r -o name,used,avail,refer,ratio,compressratio -s used "$pool" 2>/dev/null | raw
        subhead "thin provisioning: volsize vs used (zvol) in $pool"
        zfs list -t volume -r -o name,used,avail,refreservation,volsize "$pool" 2>/dev/null | raw
    done
    ok "dataset listing completed"
    check_end
}

do_zfs_arc() {
    check_begin zfs.arc "$(check_title zfs.arc)"
    if [[ -r $PH_ARCSTATS ]]; then
        local hits misses size cmax cmin total hits_pct
        hits=$(awk '/^hits /{print $3; exit}' "$PH_ARCSTATS")
        misses=$(awk '/^misses /{print $3; exit}' "$PH_ARCSTATS")
        size=$(awk '/^size /{print $3; exit}' "$PH_ARCSTATS")
        cmax=$(awk '/^c_max /{print $3; exit}' "$PH_ARCSTATS")
        cmin=$(awk '/^c_min /{print $3; exit}' "$PH_ARCSTATS")
        metric "Current ARC size" "$(human_bytes "${size:-0}")"
        metric "Max ARC size" "$(human_bytes "${cmax:-0}")"
        metric "Min ARC size" "$(human_bytes "${cmin:-0}")"
        hits=${hits:-0}; misses=${misses:-0}
        total=$((hits + misses))
        hits_pct=$(pct_of "$hits" "$total")
        metric "Hit ratio" "${hits_pct}% (hits: ${hits}, misses: ${misses})"
        if is_number "$PH_THRESH_ARC_HIT_WARN" && gt "$PH_THRESH_ARC_HIT_WARN" 0 \
           && is_number "$hits_pct" && lt "$hits_pct" "$PH_THRESH_ARC_HIT_WARN"; then
            warn "ARC hit ratio ${hits_pct}% < ${PH_THRESH_ARC_HIT_WARN}%"
        else
            info "ARC hit ratio is informational (set PH_THRESH_ARC_HIT_WARN to enable warning)"
        fi
    elif have arc_summary; then
        arc_summary 2>/dev/null | grep -E "ARC size|Hit Ratio|Target size|Min size|Max size" | raw
        info "read from arc_summary (${PH_ARCSTATS} unavailable)"
    else
        skip "ARC statistics not available (${PH_ARCSTATS} not readable)"
    fi
    check_end
}

do_zfs_trim() {
    check_begin zfs.trim "$(check_title zfs.trim)"
    if ! have zpool; then
        skip "zpool not available"
        check_end
        return 0
    fi
    if (( ${#PH_POOLS[@]} == 0 )); then
        skip "no ZFS pool detected"
        check_end
        return 0
    fi

    local pool autotrim periodic periodic_src unit state
    for pool in "${PH_POOLS[@]}"; do
        subhead "pool: $pool"
        zpool status -t "$pool" 2>/dev/null | raw

        autotrim=$(zpool get -H -o value autotrim "$pool" 2>/dev/null)
        metric "autotrim" "${autotrim:-N/A}"

        periodic="no"
        periodic_src=""
        for unit in "zfs-trim-weekly@${pool}.timer" "zfs-trim-monthly@${pool}.timer"; do
            if have systemctl && systemctl is-enabled "$unit" >/dev/null 2>&1; then
                state=$(systemctl is-active "$unit" 2>/dev/null || true)
                metric "$unit" "${state:-unknown}"
                if [[ $state == active ]]; then
                    periodic="yes"; periodic_src="$unit"
                fi
            fi
        done

        if [[ -f /etc/cron.d/zfsutils-linux ]] && grep -q "/usr/lib/zfs-linux/trim" /etc/cron.d/zfsutils-linux 2>/dev/null; then
            local ptrim
            ptrim=$(zfs get -H -o value org.debian:periodic-trim "$pool" 2>/dev/null || true)
            ptrim=${ptrim:-auto}
            metric "org.debian:periodic-trim" "$ptrim"
            case $ptrim in
                enable)
                    periodic="yes"; periodic_src="cron Debian (periodic-trim=enable)" ;;
                disable)
                    info "Debian monthly trim disabled for pool $pool" ;;
                auto|"-"|"")
                    if pool_is_nvme_only "$pool"; then
                        periodic="yes"; periodic_src="cron Debian (auto, NVMe-only pool)"
                    else
                        info "in auto mode the Debian cron skips non NVMe-only pools"
                    fi ;;
                *)
                    info "unrecognised org.debian:periodic-trim value: $ptrim" ;;
            esac
        else
            metric "Debian trim cron" "absent"
        fi

        if [[ $autotrim == on ]]; then
            ok "TRIM handled by ZFS autotrim (autotrim=on)"
            [[ $periodic == yes ]] && info "an explicit periodic TRIM is also active: $periodic_src"
        elif [[ $periodic == yes ]]; then
            ok "TRIM handled by explicit periodic job: $periodic_src (autotrim=off)"
        else
            warn "no TRIM mechanism active on pool $pool (autotrim=off and no periodic job)"
        fi
    done
    check_end
}

do_zfs_dedup() {
    check_begin zfs.dedup "$(check_title zfs.dedup)"
    if ! have zpool; then
